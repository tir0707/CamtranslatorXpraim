<Window x:Class="CamtranslatorXpraim.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CamtranslatorXpraim" Width="860" Height="790" MinWidth="680" MinHeight="640" Background="#101820" Foreground="#E9F3F7">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
<TextBlock Text="CamtranslatorXpraim" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="iPhone как веб-камера · локальное соединение" Foreground="#AFC5CE" Margin="0,5,0,22"/>
<TextBlock x:Name="StatusText" Text="Запуск…" FontSize="18" Margin="0,0,0,14"/>
<WrapPanel><Button Content="Открыть видео" Click="Preview_Click"/><Button Content="Отключить iPhone" Click="Disconnect_Click"/><Button Content="Обновить код" Click="Code_Click"/></WrapPanel>
<Border Background="#1D303A" Padding="18" CornerRadius="12" Margin="0,8,0,16"><StackPanel><TextBlock Text="Сопряжение · код действует 5 минут"/><TextBlock x:Name="CodeText" FontSize="36" FontFamily="Consolas" FontWeight="Bold"/><TextBlock Text="На iPhone откройте приложение или адрес Safari ниже. Введите код и подтвердите подключение здесь."/><TextBlock x:Name="AddressesText" Margin="0,12,0,0" FontFamily="Consolas"/><Button Content="Обновить адреса и проверить USB" Click="Network_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
<TextBlock Text="Диагностика потока" FontSize="18"/><TextBlock x:Name="MetricsText" Text="Данные появятся при получении реального видео." Margin="0,8,0,14"/>
<WrapPanel><Button Content="Снимок · Ctrl+S" Click="Snapshot_Click"/><Button x:Name="RecordButton" Content="Запись · Ctrl+R" Click="Record_Click"/><CheckBox x:Name="MirrorBox" Content="Зеркало в предпросмотре" Checked="Mirror_Changed" Unchecked="Mirror_Changed" VerticalAlignment="Center"/></WrapPanel>
<TextBlock Text="Виртуальная камера OBS" FontSize="18" Margin="0,12,0,8"/><TextBlock Text="Откройте бесплатный OBS Studio → Сервис → Настройки сервера WebSocket. Включите сервер (порт 4455), затем введите его пароль. Кнопка создаст сцену с захватом окна видео и включит OBS Virtual Camera."/>
<WrapPanel Margin="0,10,0,0"><PasswordBox x:Name="ObsPassword" Width="220" Height="34" Margin="0,0,12,8"/><Button Content="Настроить OBS и включить камеру" Click="Obs_Click"/></WrapPanel>
<Expander Header="Подключение, сохранение и сертификат" Margin="0,16,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="Для Safari и нативного приложения установите локальный сертификат на iPhone и включите полное доверие. Сравните SHA-256 с указанным ниже. Не игнорируйте ошибки сертификата."/><TextBlock x:Name="CertificateText" FontSize="12" Margin="0,8"/><WrapPanel><Button Content="Открыть папку сертификата" Click="Certificate_Click"/><Button Content="Папка снимков и записей" Click="Folder_Click"/><Button Content="Выбрать папку" Click="ChooseFolder_Click"/></WrapPanel><CheckBox x:Name="TrayBox" Content="Сворачивать в системный трей" IsChecked="True"/><CheckBox x:Name="StartupBox" Content="Запускать при входе в Windows" Click="Startup_Click"/><TextBlock Text="Запись WebM ограничена примерно 256 МБ за один фрагмент. OBS позволяет записывать длинные сеансы. Звук передаётся в предпросмотр; OBS Virtual Camera не создаёт виртуальный микрофон." Margin="0,10"/></StackPanel></Expander>
<TextBlock Text="Wi-Fi и USB используют один локальный WebRTC-транспорт. Наличие Apple-сетевого интерфейса — признак возможного USB; маршрут медиапотока требует отдельной проверки." Foreground="#AFC5CE" Margin="0,20,0,0"/>
</StackPanel></ScrollViewer></Window>
